# Merge into the known-good Neo ARM64 build config for Max hardware probes.
# All 16 CPUs must remain available; never use maxcpus/nosmp/CPU filtering.
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARCH_APPLE=y
CONFIG_RUST=y
CONFIG_DRM_ASAHI=y
CONFIG_APPLE_AIC=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_RUST_APPLE_RTKIT=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
