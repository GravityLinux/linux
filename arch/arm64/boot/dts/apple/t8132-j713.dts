/*
 * Apple MacBook Air (13-inch, M4, 2025)
 *
 * target-type: J713
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"
#include "t8132-mtp.dtsi"
#include "t8132-gpu.dtsi"
#include "t8132-j713-thermal.dtsi"
#include <dt-bindings/leds/common.h>

/ {
	compatible = "apple,j713", "apple,t8132", "apple,arm-platform";
	model = "Apple MacBook Air (13-inch, M4, 2025)";

	aliases {
		keyboard = &keyboard;
		/* m1n1 maps the iBoot-provided MTP segments through this alias. */
		mtp = &mtp;
		/*
		 * No external display support yet. m1n1 enables every DCP behind a
		 * dcpextN alias that the ADT lists, but not its DARTs or mailbox;
		 * appledrm then never finishes init and boot blocks before userspace.
		 */
		/delete-property/ dcpext0;
		/delete-property/ dcpext1;
	};

	led-controller {
		compatible = "pwm-leds";
		led-0 {
			pwms = <&fpwm1 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

&dcp {
	status = "okay";

	panel: panel {
		compatible = "apple,panel-j713", "apple,panel";
		/*
		 * Unverified on J713: dimensions and brightness are taken from
		 * the M2 MacBook Air 13" (J413), which uses a 13.6" panel of the
		 * same size.
		 */
		width-mm = <290>;
		height-mm = <189>;
		adj-height-mm = <181>;
		apple,max-brightness = <525>;
	};
};

&dcp_dart {
	status = "okay";
};

&dcp_mbox {
	status = "okay";
};

&disp0_dart {
	status = "okay";
};

/*
 * The firmware-owned display CPU domain is locked on T8132; referencing it
 * holds simpledrm back until the deferred-probe timeout. Use the managed
 * display FE domain, as J773g does.
 */
&framebuffer0 {
	power-domains = <&ps_disp_fe>, <&ps_dptx_phy>;
	panel = <&panel>;
	post-init-providers = <&panel>;
};

&fpwm1 {
	status = "okay";
};

&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	status = "okay";
	wakeup-source;

	multi-touch {
		firmware-name = "apple/tpmtfw-j713.bin";
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};

	stm {
	};

	actuator {
	};

	tp-accel {
	};

	mtp {
	};
};

/*
 * J713 has two USB-C ports (ATC0, ATC1). ATC2/ATC3 don't exist: the ADT lists
 * their power states without PS registers, so turning them on only fails.
 */
&dwc3_2 {
	status = "disabled";
};

&dwc3_2_dart_0 {
	status = "disabled";
};

&dwc3_2_dart_1 {
	status = "disabled";
};

&atcphy2 {
	status = "disabled";
};

&dwc3_3 {
	status = "disabled";
};

&dwc3_3_dart_0 {
	status = "disabled";
};

&dwc3_3_dart_1 {
	status = "disabled";
};

&atcphy3 {
	status = "disabled";
};

&ps_atc2_common {
	status = "disabled";
};

&ps_atc2_pcie {
	status = "disabled";
};

&ps_atc2_cio {
	status = "disabled";
};

&ps_atc2_cio_pcie {
	status = "disabled";
};

&ps_atc2_cio_usb {
	status = "disabled";
};

&ps_atc2_usb_aon {
	status = "disabled";
};

&ps_atc2_usb {
	status = "disabled";
};

&ps_atc3_common {
	status = "disabled";
};

&ps_atc3_pcie {
	status = "disabled";
};

&ps_atc3_cio {
	status = "disabled";
};

&ps_atc3_cio_pcie {
	status = "disabled";
};

&ps_atc3_cio_usb {
	status = "disabled";
};

&ps_atc3_usb_aon {
	status = "disabled";
};

&ps_atc3_usb {
	status = "disabled";
};

/*
 * The J713 radio module is "garden" (ADT /arm-io/wlan module-instance).
 * m1n1 adds the antenna SKU, MAC address and calibration from the ADT.
 */
&wifi0 {
	brcm,board-type = "apple,garden";
};

&bluetooth0 {
	brcm,board-type = "apple,garden";
};

/*
 * The internal eDP panel is driven through the DPTX PHY. DCP needs it
 * powered: without it the panel stays dark (backlight only), DPTX reports
 * FIFO errors, and DCP crashes on power-off touching the PHY registers.
 */
&dptxphy {
	status = "okay";
};

&dcp {
	phys = <&dptxphy>;
	phy-names = "dp-phy";
	apple,dptx-phy = <4>;
};

#include "hwmon-common.dtsi"
#include "hwmon-laptop.dtsi"

/*
 * J713 SoC sensors, identified on the Air by behavior: under an all-core CPU
 * load Tp0f is among the hottest of the Tp keys (49 -> 106 C), and the PP0b/VP0b/IP0b rail follows
 * the load (1.5 -> 10 W, 0.61 -> 0.97 V, 2.4 -> 10.3 A; V * I matches P).
 * PMVR from hwmon-common doesn't exist on this SMC and is skipped.
 */
&smc_hwmon {
	temperature-Tp0f {
		apple,key-id = "Tp0f";
		label = "CPU Temperature";
	};
	power-PP0b {
		apple,key-id = "PP0b";
		label = "CPU Rail Power";
	};
	voltage-VP0b {
		apple,key-id = "VP0b";
		label = "CPU Rail Voltage";
	};
	current-IP0b {
		apple,key-id = "IP0b";
		label = "CPU Rail Current";
	};
};

/*
 * Research (t8132-pmp-votes): run PMP with steady votes for everything the
 * system uses; the GPU vote follows its genpd (t8132-gpu.dtsi).
 */
&pmp_report_boot_f {
	apple,always-on;
};

&pmp_report_boot_10 {
	apple,always-on;
};

&pmp_report_atc0_common {
	apple,always-on;
};

&pmp_report_atc1 {
	apple,always-on;
};

&pmp_report_atc2 {
	apple,always-on;
};

&pmp_report_atc3_common {
	apple,always-on;
};

&pmp_report_boot_18 {
	apple,always-on;
};

&pmp_report_disp {
	apple,always-on;
};

&pmp_report_soc_ni0 {
	apple,always-on;
};

&pmp_report_soc_ni1 {
	apple,always-on;
};

&pmp_report_soc_ni3 {
	apple,always-on;
};

&pmp_report_soc_ni4 {
	apple,always-on;
};

&pmp_report_soc_ni5 {
	apple,always-on;
};

&pmp_report_ans {
	apple,always-on;
};

&pmp_report_pcie {
	apple,always-on;
};

&pmp_dart {
	status = "okay";
};

&pmp_report {
	status = "okay";
};

&pmp_mbox {
	status = "okay";
};

&pmp {
	status = "okay";
};
