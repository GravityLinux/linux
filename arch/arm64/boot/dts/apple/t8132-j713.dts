&ps_ispsens0 {
	status = "disabled";
};

&ps_ispsens1 {
	status = "disabled";
};

&ps_isp_cpu {
	status = "disabled";
};

&ps_isp_cpu_core0 {
	status = "disabled";
};

&ps_isp_cpu_core1 {
	status = "disabled";
};

&ps_isp_fe {
	status = "disabled";
};

&ps_isp_dprx {
	status = "disabled";
};

&ps_isp_secure {
	status = "disabled";
};

&ps_isp_sts0 {
	status = "disabled";
};

&ps_isp_sts1 {
	status = "disabled";
};

&ps_isp_pearl {
