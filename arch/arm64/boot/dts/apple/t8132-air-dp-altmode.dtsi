/* J713/J715 ADTs share both external DCPs, ATC0/1 and DP audio channels. */
#include "t8132-dp-altmode.dtsi"

/ {
	aliases {
		dcpext0 = &dcpext0;
		dcpext1 = &dcpext1;
		sio = &sio;
	};
};

&dcpext0 { status = "okay"; };
&dcpext1 { status = "okay"; };
&dcpext0_dart { status = "okay"; };
&dcpext1_dart { status = "okay"; };
&dcpext0_mbox { status = "okay"; };
&dcpext1_mbox { status = "okay"; };
&dispext0_dart { status = "okay"; };
&dispext1_dart { status = "okay"; };
&atcphy0_dpxbar { status = "okay"; };
&atcphy1_dpxbar { status = "okay"; };
&dp_altmode0 { status = "okay"; };
&dp_altmode1 { status = "okay"; };
&sio_dart { status = "okay"; };
&sio_mbox { status = "okay"; };
&sio { status = "okay"; };
&dpaudio1 { status = "okay"; };
&dpaudio2 { status = "okay"; };

&display {
	iommus = <&disp0_dart 0>, <&dispext0_dart 0>, <&dispext1_dart 0>;
};

/*
 * Fixed direct-DP routes for the J713 test. ADT HPM0 is left-front and
 * HPM1 left-back; each ATC dpphy is direct DFP port 0. The external DCPs
 * are UFP endpoints 1 and 2, stream 0 (crossbar sources 2 and 4).
 * The Air macOS plug capture uses ATC0/source2 with external0.
 */
&dp_altmode0 {
	compatible = "apple,t8132-fixed-dp";
	/delete-property/ apple,display-engines;
	apple,display-engine = <&dcpext0>;
	mux-index = <2>;
};

&dp_altmode1 {
	compatible = "apple,t8132-fixed-dp";
	/delete-property/ apple,display-engines;
	apple,display-engine = <&dcpext1>;
	mux-index = <4>;
};
